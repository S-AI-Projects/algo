{
  "assignment": "R61-T026",
  "issue": 26,
  "target_file": "docs/extra/Fenwick Tree/FenwickTree.md",
  "test_cases": [
    {
      "id": "ORIGINAL_EXAMPLE_STDOUT",
      "description": "Original worked example execution stdout from documentation",
      "tree_size": 10,
      "operations": [
        {"type": "update", "index": 3, "val": 5},
        {"type": "update", "index": 5, "val": 2},
        {"type": "getSum", "index": 5},
        {"type": "rangeSum", "left": 3, "right": 5},
        {"type": "getSum", "index": 0}
      ],
      "expected_lines": [
        "Sum from 1 to 5: 7",
        "Range Sum from 3 to 5: 7",
        "Empty prefix sum (getSum(0)): 0"
      ]
    },
    {
      "id": "BOUNDARY_EMPTY_PREFIX",
      "description": "Empty prefix query boundary condition (getSum(0) == 0)",
      "query_index": 0,
      "expected_return": 0
    },
    {
      "id": "BOUNDARY_RANGE_LOWER_BOUND",
      "description": "Range sum covering from lower bound 1 to 5 relying on getSum(0) == 0",
      "range": [1, 5],
      "expected_return": 7
    },
    {
      "id": "POINT_PREFIX_QUERIES",
      "description": "Prefix sum queries across tree indices",
      "expected_sums": {
        "getSum(0)": 0,
        "getSum(1)": 0,
        "getSum(2)": 0,
        "getSum(3)": 5,
        "getSum(4)": 5,
        "getSum(5)": 7,
        "getSum(6)": 7,
        "getSum(7)": 7,
        "getSum(8)": 7
      }
    },
    {
      "id": "RANGE_SUM_QUERIES",
      "description": "Range sums over various subsegments",
      "expected_ranges": {
        "rangeSum(3, 5)": 7,
        "rangeSum(3, 3)": 5,
        "rangeSum(5, 5)": 2,
        "rangeSum(4, 5)": 2,
        "rangeSum(1, 10)": 7
      }
    },
    {
      "id": "SUBSEQUENT_UPDATE",
      "description": "Subsequent update at index 1 and verification of propagating effects",
      "update": {"index": 1, "val": 10},
      "expected_sums": {
        "getSum(1)": 10,
        "getSum(3)": 15,
        "getSum(5)": 17,
        "rangeSum(1, 3)": 15
      }
    }
  ],
  "deliberate_failure_tests": [
    {
      "id": "DELIBERATE_ORIGINAL_MISMATCH",
      "description": "Intentional assertion mismatch on original stdout",
      "tested_expected": "Sum from 1 to 5: 999",
      "actual_received": "Sum from 1 to 5: 7",
      "expected_failure_type": "AssertionError"
    },
    {
      "id": "DELIBERATE_BOUNDARY_MISMATCH",
      "description": "Intentional assertion mismatch on boundary query getSum(0)",
      "tested_expected": 99,
      "actual_received": 0,
      "expected_failure_type": "AssertionError"
    }
  ]
}
